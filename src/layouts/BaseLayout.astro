---
import '../styles/main.scss';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:200,300,600,900"
      rel="stylesheet"
    />
    <link
      href="https://use.fontawesome.com/releases/v5.0.7/css/all.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <noscript>
      <strong>Javascript disabled? Don't be afraid, you can safely enable it here.</strong>
    </noscript>
    <slot />
  </body>
</html>
